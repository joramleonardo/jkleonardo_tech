<IfModule mod_rewrite.c>
    RewriteEngine On

    # Set default directory index
    DirectoryIndex index.php index.html

    # 1. Block direct web access to sensitive root files and directories
    RewriteRule ^(\.env.*|\.git.*|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|artisan)$ - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/.*)?$ - [F,L,NC]

    # 2. Preserve subdomains (e.g. hatian.jkleonardo.tech, ticketingportal.jkleonardo.tech, etc.)
    RewriteCond %{HTTP_HOST} !^(www\.)?jkleonardo\.tech$ [NC]
    RewriteRule ^ - [L]

    # 3. Preserve existing subfolders/subdirectories (e.g., /hatian, /christmasparty, /eoasystem, etc.)
    # Exclude root ("" or "/") and "/public"
    RewriteCond %{REQUEST_URI} !^/?$
    RewriteCond %{REQUEST_URI} !^/public(/|$) [NC]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 4. If an existing file in root is requested, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 5. Route root request directly to public/index.php
    RewriteRule ^$ public/index.php [L]

    # 6. Route all other requests to public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
