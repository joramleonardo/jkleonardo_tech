<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct web access to sensitive root files
    RewriteRule ^(\.env.*|\.git.*|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|artisan)$ - [F,L,NC]

    # Preserve existing directories and files (subdomains like /hatian, /christmasparty, etc.)
    RewriteCond %{REQUEST_FILENAME} -d [OR]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Route all requests cleanly to the Laravel public/ directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
